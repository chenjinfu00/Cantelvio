{
  "name": "ailegro-score",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "AIlegro Score: a web-based music notation editor for piano, chamber and orchestral music, designed as the score front end for AIlegro.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "npm run dev -w @ailegro-score/web",
    "build": "npm run build -w @ailegro-score/web",
    "preview": "npm run preview -w @ailegro-score/web",
    "typecheck": "tsc -p tsconfig.json && tsc -p packages/tsconfig.json && tsc -p tools/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm run test",
    "render": "tsx tools/render-score.ts",
    "gen:smufl": "node packages/engraving/scripts/gen-smufl.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^24.0.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.0.0",
    "opentype.js": "^1.3.4",
    "prettier": "^3.9.9",
    "sharp": "^0.34.5",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
